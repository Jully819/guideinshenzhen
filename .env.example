# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Cal.com -----------------------------------------------------------------
# Settings → Developer → API keys
CAL_API_KEY=

# ONE event type backs every booking. The numeric id is in its URL.
# Configure it for MULTIPLE DURATIONS — 240 and 480 minutes — because the
# business sells a half day and a full day of the same guide. Two separate
# event types would each have to mark the host busy for the other, or the same
# guide gets booked twice at 09:00.
#
# With this unset, /api/availability serves synthesised sample slots so the
# booking flow can be walked — but only outside production, where it 503s.
CAL_EVENT_TYPE_ID_GUIDE=

# --- Stripe ------------------------------------------------------------------
# Test keys start sk_test_ / pk_test_. Do not put live keys here during build.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`,
# or the Stripe dashboard once deployed. Different value per environment.
STRIPE_WEBHOOK_SECRET=

# --- Inquiries ---------------------------------------------------------------
# Where /inquiry sends trip requests. Same contract as MESSAGES_WEBHOOK_URL
# below: any endpoint that accepts a JSON POST. Falls back to
# MESSAGES_WEBHOOK_URL when unset, so a small operation can point both at one
# Slack channel and a larger one can route quote requests separately.
#
# With NEITHER set, /api/inquiry answers 503 and the form shows the WhatsApp
# and email links instead of a confirmation. It never pretends to have sent.
INQUIRY_WEBHOOK_URL=

# --- Messages ----------------------------------------------------------------
# Where the chat widget's messages go. Any endpoint that accepts a JSON POST:
# a Slack or Discord incoming webhook, Zapier, n8n, a mail-sending function.
# The body carries a pre-formatted `text` field plus name / email / message /
# page, so Slack and Discord render it with no mapping step.
#
# UNSET, THE FORM REFUSES TO PRETEND. /api/message answers 503 and the widget
# shows the WhatsApp and email links instead of a confirmation tick. Messages
# are logged to the server console so nothing typed in development is lost.
MESSAGES_WEBHOOK_URL=

# --- Site --------------------------------------------------------------------
# Absolute origin, no trailing slash. Stripe redirects back here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
